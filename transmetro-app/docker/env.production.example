# Copiar a transmetro-app/.env.production y completar los valores marcados con <>.
APP_NAME=Transmetro
APP_ENV=production
APP_DEBUG=false
APP_KEY=<generar con: php artisan key:generate --show>
APP_URL=https://<IP-con-guiones>.sslip.io
APP_LOCALE=es
LOG_CHANNEL=stderr
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
TRUSTED_PROXIES=*

# Oracle Autonomous Database (TLS sin wallet). La cadena sale de la consola:
# Autonomous Database > Database connection > TLS > <nombre>_low
DB_CONNECTION=oracle
DB_TNS=<cadena de conexión TLS completa entre paréntesis>
DB_USERNAME=TRANSMETRO
DB_PASSWORD=<contraseña del usuario TRANSMETRO>
DB_SERVER_VERSION=12c
ORA_MAX_NAME_LEN=128
